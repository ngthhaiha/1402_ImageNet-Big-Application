# .env.example
# Copy file này thành .env và điền giá trị thực

# Backend
DATABASE_URL=sqlite:///./anomaly.db
UPLOAD_DIR=uploads
MAX_BATCH_SIZE_MB=300

# Authentication
JWT_SECRET_KEY=change-this-to-a-random-secret-key-for-demo
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

# Frontend (trong thư mục frontend/)
VITE_API_URL=http://localhost:8000
